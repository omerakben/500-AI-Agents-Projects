{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/omerakben/500-ai-agents-projects/cowork-business-folders/standard/folder.schema.json",
  "title": "Cowork Business Folder Manifest",
  "description": "Schema for folder.yaml — the manifest of a Cowork business folder.",
  "type": "object",
  "required": ["slug", "name", "category", "version", "summary", "same_day_win", "connectors", "skills", "schedules"],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case identifier; must match the directory name."
    },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["core", "finance", "growth", "operations", "people", "professional", "commerce"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "semver"
    },
    "summary": { "type": "string", "minLength": 1 },
    "same_day_win": { "type": "string", "minLength": 1 },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "why"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "summary"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "cadence", "summary"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "cadence": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "summary"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "maintainers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
